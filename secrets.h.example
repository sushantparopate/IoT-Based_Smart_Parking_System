// Copy this file to "secrets.h" (same folder) and fill in your real values.
// secrets.h is gitignored, so it never gets committed — this .example file
// is what stays in the repo so other people know what to create.
#pragma once

// ── Blynk credentials ────────────────────────────────────
// Get these from your Blynk IoT dashboard: Template Settings > Info
#define BLYNK_TEMPLATE_ID   "YOUR_BLYNK_TEMPLATE_ID"
#define BLYNK_TEMPLATE_NAME "YOUR_BLYNK_TEMPLATE_NAME"
#define BLYNK_AUTH_TOKEN    "YOUR_BLYNK_AUTH_TOKEN"

// ── WiFi credentials ─────────────────────────────────────
#define WIFI_SSID   "YOUR_WIFI_SSID"
#define WIFI_PASS   "YOUR_WIFI_PASSWORD"
